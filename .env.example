# statseat backend: local settings. Copy to .env (never committed). No keys: authentication is `az login`
# (DefaultAzureCredential); in Azure the Container App's managed identity. infra/ sets the same names for the deploy.

# --- Match engine (app/engine/README.md) ---
# MATCH_SOURCE=synthetic:SYN-001
# ENGINE_SPEED=10

# --- Ask Archie on Foundry (AG-1b, AG-2). Without the endpoint and the two agent names, Ask Archie stays on the mock. ---
# The demo project on the team's Azure subscription. Not a secret: access is `az login` with the Foundry User role.
# Foundry portal (ai.azure.com) -> project -> Overview -> "Project endpoint"
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>
# Model deployment of every agent (credit rules: one model, gpt-6-luna)
FOUNDRY_MODEL=gpt-6-luna
# ANALYST_MODEL=gpt-6-sol

# The agents, called by name and version. Versions in use on 26/10 (update them here when a new one is made with
# `python -m app.agents setup`, and tell the team):
# - Archie 9: the defensive line and team length point to their chart; acceleration load is never used or pointed to
#   (the server also drops it from the chart ids). Otherwise as 8.
# - Archie 8 (AG-5): the tone, xG only when asked, the Analyst plan, the table of each number; same tools as 7
#   (ask_the_analyst and ask_kit_man, AG-2). With a server without ask_kit_man (before AG-2), use 6.
# - The Analyst 3 (AG-5): the 12 tools of AG-1a on the E-4 numbers, the gold version named "Analyst".
# - Kit Man 2: file search on the SYN-001 matchday documents (M-4).
ARCHIE_AGENT_ID=archie-gpt-6-luna-VL4
ARCHIE_AGENT_VERSION=9
ANALYST_AGENT_ID=the-analyst-gpt-6-luna
ANALYST_AGENT_VERSION=3
KITMAN_AGENT_ID=kitman
KITMAN_AGENT_VERSION=2
# - The Ref 1: rewrites the half-time quiz in the fan's language (AG-4). Defaults the-ref and 1; with the endpoint set,
#   the quiz is in the fan's language, without it in the code's English.
# THE_REF_AGENT_ID=the-ref
# THE_REF_AGENT_VERSION=1

# Limits per question (defaults shown)
# ARCHIE_MAX_ROUNDS=4
# ARCHIE_MAX_TOOL_CALLS=4
# ARCHIE_MAX_TOKENS=30000
# ARCHIE_TIMEOUT_S=30
# AG-5: The Analyst starts in parallel with Archie (about 3 s less on a question with numbers); 0 turns it off
# ARCHIE_PREFETCH_ANALYST=1
